# ==============================================================================
# Terraform
# ==============================================================================

# Provider binaries and module cache. Large (hundreds of MB) and reproducible.
**/.terraform/*

# Local state. The examples run without a backend, so these would contain group
# object IDs, UPNs and access package policy in cleartext.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Plan files. Same sensitive values as state.
*.tfplan
*.tfplan.*
plan.out

# Crash logs from Terraform and from providers.
crash.log
crash.*.log

# ------------------------------------------------------------------------------
# Variable files
#
# terraform.tfvars holds the real tenant ID, the state storage account name and any
# per-scope overrides. Never commit it. The example file with placeholders does
# belong in git.
# ------------------------------------------------------------------------------
*.tfvars
*.tfvars.json
!*.tfvars.example
!terraform.tfvars.example

# Backend configuration. Names the storage account holding both repos' state, so it
# is kept out even though it holds no secret by itself.
backend.hcl
!backend.hcl.example

# CLI config, which can contain credentials or mirror settings.
.terraformrc
terraform.rc

# ------------------------------------------------------------------------------
# Lock files
#
# The root module's .terraform.lock.hcl MUST be committed — it pins provider
# versions. Child modules do not pin, and the examples are demonstrations rather
# than deployments, so their lock files are kept out.
# ------------------------------------------------------------------------------
modules/**/.terraform.lock.hcl
examples/**/.terraform.lock.hcl

# ==============================================================================
# Credentials and environment
# ==============================================================================

.env
.env.*
*.pem
*.key
azure-credentials.json
sp-credentials.json

# ==============================================================================
# Tooling and OS
# ==============================================================================

# Intermediate files from diagram generation. PNG and .drawio are committed
# deliberately.
generated-diagrams/*.dot

.DS_Store
.vscode/
.idea/
*.swp
*~
