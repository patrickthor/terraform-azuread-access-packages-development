# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Note what is NOT here: no scope list, no role list, no group names. Those are read
# from repo 1's state. Adding a scope or a role in repo 1 and re-applying repo 2
# picks it up with no change to this file.
#
# Field reference: modules/access-packages/README.md

tenant_id = "8aacb043-2429-460e-b9d1-d81459e9330e"

catalog_display_name = "Cloud Access"

# Where repo 1's state lives, so the taxonomy can be read. The deploy identity needs
# Storage Blob Data Reader on this storage account.
state_resource_group_name  = "rg-tfstate-poc"
state_storage_account_name = "sttfstatepocbvt"
vending_state_key          = "access-vending.tfstate"

defaults = {
  assignment_duration_days = 14   # keep <= m3_max_duration_days for scopes with pim_for_groups roles
  requestor_scope_type     = "AllExistingDirectoryMemberUsers"
  require_justification    = true
  approval_timeout_days    = 7
  grant_approver_group     = true # option A: the package also grants peer-approval rights
}

# Only where you deviate from defaults.
scope_overrides = {
  # The tenant scope hands out Groups Administrator, and Terraform cannot set that
  # role's activation rules at all, so gate 1 is the only control it enforces. Short
  # duration is the mitigation available here.
  "tenant" = { assignment_duration_days = 7 }
}
