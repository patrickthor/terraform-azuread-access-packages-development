# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored here; in a
# customer root it is committed, because for an access system the configuration IS the
# governance record.
#
# Note what is NOT here: no scope list, no role list, no group name, no catalog label.
# All of it comes from repo 1's contract. Adding a scope, a role or a catalog in repo 1
# and re-applying picks it up with no change to this file.
#
# Field reference: modules/access-packages/README.md

tenant_id = "8aacb043-2429-460e-b9d1-d81459e9330e"

# Where repo 1's state lives, so the contract can be read. Only needed by this
# split-state root — a customer using the reference architecture calls both modules from
# one root and needs none of these three.
state_resource_group_name  = "rg-tfstate-poc"
state_storage_account_name = "sttfstatepocbvt"
vending_state_key          = "access-vending.tfstate"

# Optional. A catalog label with no entry here gets a catalog named after the label,
# created rather than adopted, published, and not externally visible.
catalogs = {
  "platform" = {
    display_name = "Cloud Access"
  }

  # The tenant scope hands out Groups Administrator. Its own catalog keeps it visible in
  # a listing rather than buried among ordinary cloud access.
  "privileged" = {
    display_name = "Privileged Directory Access"
  }
}

defaults = {
  assignment_duration_days = 14
  requestor_scope_type     = "AllExistingDirectoryMemberUsers"
  require_justification    = true
  approval_timeout_days    = 7

  # The package also grants the scope's approver group, making everyone in the scope a
  # peer approver. Resolves the deadlock where a lone systemeier cannot approve their own
  # activation request.
  grant_approver_group = true
}

# Named packages. Leave unset for the default: one package per scope, every role in it.
# Set it when one scope needs more than one audience over the same groups:
#
# packages = {
#   "prod-engineers" = {
#     display_name = "Prod Engineer Access"
#     role_keys    = ["prod--reader", "prod--contributor"]
#   }
#   "prod-admins" = {
#     display_name             = "Prod Admin Access"
#     role_keys                = ["prod--reader", "prod--contributor", "prod--owner"]
#     assignment_duration_days = 7
#     grant_approver_group     = true   # the senior tier approves peers
#   }
# }

# Recurring access reviews. MASTER SWITCH, off by default — drive it from a pipeline checkbox.
#
# While false, review settings are still resolved and reported (see the access_reviews and
# access_reviews_configured_not_deployed outputs) but nothing is written to any assignment
# policy. That lets the configuration be written and merged before it goes live.
enable_access_reviews = false

# Reviews are selected by PRESENCE of an access_reviews block, on defaults (which turns them on
# for every package) or on individual packages / approver_packages. There is no enabled field.
#
# A reviewed package needs an assignment duration LONGER than the review interval, or the
# assignment expires before the first campaign runs and the review has nobody in it. That is a
# plan-time failure, not a silent one.
#
# approver_packages = {
#   "tenant" = {
#     assignment_duration_days = 365
#     access_reviews = {
#       review_frequency = "halfyearly"   # weekly|monthly|quarterly|halfyearly|annual
#       review_type      = "Reviewers"    # the scope's systemeier answer it; Manager is rejected
#       duration_in_days = 21             # how long each campaign stays open
#       timeout_behavior = "removeAccess" # fails safe if nobody answers
#     }
#   }
# }

# Only where you deviate from defaults. Keyed on PACKAGE name; on the default path those
# are scope names.
package_overrides = {
  # Terraform can set no activation rules for Entra directory roles, so gate 1 is the
  # only control it enforces on this package. A short duration is the mitigation
  # available in code.
  "tenant" = { assignment_duration_days = 7 }
}
